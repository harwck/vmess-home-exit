# Copy to .env and fill in. .env is gitignored — never commit it.
# Generate values with the commands in README "Generating credentials".
# Then run ./render.sh to produce the real config files.

# VPS public IP (or hostname)
VPS_IP=

# VLESS + REALITY (sing-box `generate uuid`, `generate reality-keypair`, `generate rand 8 --hex`)
VLESS_UUID=
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=

# Shadowsocks 2022 pre-shared key (sing-box `generate rand 16 --base64`)
SS_PASSWORD=

# WireGuard keypairs (wg genkey | wg pubkey)
VPS_WG_PRIVATE_KEY=
VPS_WG_PUBLIC_KEY=
HOME_WG_PRIVATE_KEY=
HOME_WG_PUBLIC_KEY=
