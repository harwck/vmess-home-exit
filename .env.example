# Copy to .env and fill in. .env is gitignored — never commit it.
# Generate values with the commands in README "Generating credentials".
# Then run ./render.sh to produce the real config files.

# VPS public IP (or hostname) — used by wg0.conf Endpoint (home dials the VPS
# directly for the WireGuard leg, NOT through Cloudflare).
VPS_IP=

# Your domain, proxied through Cloudflare (orange cloud), A/AAAA -> VPS IP.
# The phone connects to this hostname; Cloudflare fronts the VPS.
CF_DOMAIN=

# VLESS over WebSocket + TLS (sing-box `generate uuid`; WS_PATH is any secret path)
VLESS_UUID=
WS_PATH=/your-secret-path

# WireGuard keypairs (wg genkey | wg pubkey)
VPS_WG_PRIVATE_KEY=
VPS_WG_PUBLIC_KEY=
HOME_WG_PRIVATE_KEY=
HOME_WG_PUBLIC_KEY=
