{
  "log": {
    "level": "error",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "uuid": "${VLESS_UUID}"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${CF_DOMAIN}",
        "certificate_path": "/etc/sing-box/certs/cert.pem",
        "key_path": "/etc/sing-box/certs/key.pem"
      },
      "transport": {
        "type": "ws",
        "path": "${WS_PATH}"
      }
    }
  ],
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "wg-home",
      "system": false,
      "mtu": 1408,
      "address": [
        "10.10.0.1/32"
      ],
      "private_key": "${VPS_WG_PRIVATE_KEY}",
      "listen_port": 51820,
      "peers": [
        {
          "public_key": "${HOME_WG_PUBLIC_KEY}",
          "allowed_ips": [
            "0.0.0.0/0",
            "::/0"
          ],
          "persistent_keepalive_interval": 25
        }
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": [
          "vless-in"
        ],
        "outbound": "wg-home"
      }
    ],
    "final": "wg-home"
  }
}
