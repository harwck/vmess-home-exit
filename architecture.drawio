<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="ss-tunnel-arch" name="VLESS+REALITY Tunnel Architecture">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="VLESS+REALITY Tunnel — Phone &#8594; VPS &#8594; Home Server &#8594; Internet (exit via residential IP)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="1280" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== PHONE ZONE ===================== -->
        <mxCell id="zonePhone" value="Censored Network (mobile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F2;strokeColor=#C0392B;dashed=1;verticalAlign=top;fontStyle=2;fontColor=#922B21;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="280" height="560" as="geometry" />
        </mxCell>
        <mxCell id="phone" value="📱 Android Phone&#10;&#10;sing-box client&#10;TUN mode — captures ALL traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="180" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="phoneApps" value="App traffic:&#10;• TCP (HTTP/S, etc.)&#10;• UDP (QUIC/HTTP3, DNS, VoIP)&#10;&#10;All multiplexed inside the&#10;single VLESS/TLS stream&#10;(no UDP on the censored wire)&#10;&#10;DNS &#8594; AdGuard 172.30.0.53&#10;routed through the tunnel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B7950B;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="200" height="170" as="geometry" />
        </mxCell>

        <!-- ===================== VPS ZONE ===================== -->
        <mxCell id="zoneVPS" value="VPS (public IP) — relay only, NOT the exit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2471A3;dashed=1;verticalAlign=top;fontStyle=2;fontColor=#1A5276;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="320" height="560" as="geometry" />
        </mxCell>
        <mxCell id="vpsHost" value="☁️ VPS host — Docker Compose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#2471A3;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="180" width="260" height="430" as="geometry" />
        </mxCell>
        <mxCell id="vpsSS" value="sing-box: VLESS+REALITY in&#10;Listens :443 (TCP)&#10;Real TLS 1.3 handshake to&#10;dl.google.com&#10;Decrypts phone traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AED6F1;strokeColor=#2471A3;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="675" y="230" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="vpsRoute" value="Routing / policy&#10;Default route for decrypted&#10;traffic &#8594; WireGuard tunnel&#10;(does NOT NAT to its own IP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AED6F1;strokeColor=#2471A3;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="675" y="340" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="vpsWG" value="WireGuard peer&#10;wg0 — VPS endpoint&#10;Accepts inbound tunnel from home&#10;(home dials out to here)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AED6F1;strokeColor=#2471A3;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="675" y="450" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- ===================== HOME ZONE ===================== -->
        <mxCell id="zoneHome" value="Home (no public IP) — residential ISP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAFAF1;strokeColor=#1E8449;dashed=1;verticalAlign=top;fontStyle=2;fontColor=#196F3D;" vertex="1" parent="1">
          <mxGeometry x="1220" y="120" width="320" height="560" as="geometry" />
        </mxCell>
        <mxCell id="homeHost" value="🏠 Home Server — Docker Compose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#1E8449;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1250" y="180" width="260" height="370" as="geometry" />
        </mxCell>
        <mxCell id="homeWG" value="WireGuard peer&#10;wg0 — dials OUT to VPS&#10;PersistentKeepalive keeps&#10;NAT pinhole open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ABEBC6;strokeColor=#1E8449;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1275" y="230" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="homeNAT" value="NAT / MASQUERADE&#10;Forwards tunnel traffic out&#10;the residential WAN&#10;➜ THIS IS THE EXIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ABEBC6;strokeColor=#1E8449;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1275" y="350" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- ===================== INTERNET ===================== -->
        <mxCell id="internet" value="🌐 Internet&#10;&#10;Sees your&#10;residential&#10;home IP" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#566573;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="600" width="160" height="120" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES ===================== -->
        <!-- Phone -> VPS -->
        <mxCell id="e1" value="VLESS+REALITY / TCP 443&#10;looks like real HTTPS to&#10;dl.google.com&#10;(defeats DPI + active probing)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C0392B;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#922B21;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="phone" target="vpsSS">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="240" />
              <mxPoint x="480" y="275" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- internal VPS flow -->
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2471A3;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="vpsSS" target="vpsRoute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2471A3;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="vpsRoute" target="vpsWG">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- VPS WG <-> Home WG -->
        <mxCell id="e4" value="WireGuard (UDP) tunnel&#10;clean network — home dials out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1E8449;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#196F3D;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="vpsWG" target="homeWG">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1080" y="500" />
              <mxPoint x="1080" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Home WG -> NAT -->
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1E8449;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="homeWG" target="homeNAT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Home NAT -> Internet -->
        <mxCell id="e6" value="exits via&#10;residential WAN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#566573;strokeWidth=3;fontSize=11;fontStyle=1;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="homeNAT" target="internet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend&#10;━━ red:  censorship-resistant leg (VLESS+REALITY, TCP 443)&#10;━━ green: WireGuard tunnel (home initiates outbound)&#10;━━ gray:  plain Internet egress&#10;&#10;Key idea: VPS only relays. The home server is the exit,&#10;so the public-facing source IP is your residential IP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFCFC;strokeColor=#909497;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="710" width="560" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
